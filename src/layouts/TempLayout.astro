---
import "../styles/global.css";
import 'katex/dist/katex.min.css';
const { title = "DragonLab" } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2d3748" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href="/DragonLab/images/Bg_Norway_lofoten_mountains.jpg" />
    <link rel="preload" as="image" href="/DragonLab/images/Bg_Norway_dusk.jpg" />
  </head>
  <body>
    <div class="blur-layer blur-1"></div>
    <div class="blur-layer blur-2"></div>
    <div class="blur-layer blur-3"></div>
    <div class="blur-layer blur-4"></div>
    <slot />
    <script is:inline src="/DragonLab/scripts/theme.js"></script>
    <script is:inline src="/DragonLab/scripts/app.js"></script>
    {import.meta.env.DEV && (
      <script is:inline src="/DragonLab/scripts/sync-toast.js"></script>
    )}
  </body>
</html>
