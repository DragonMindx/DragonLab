---
import TempLayout from "../layouts/TempLayout.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

import statusData from "../data/status.json";
import DomainBar from "../components/DomainBar.astro";
const status = { emoji: "📢", text: "Welcome to DragonLab", ...statusData };

const domains = [
  { key: "cs", icon: "💻", name: "CS", desc: "Computer Science" },
  { key: "ml", icon: "🧠", name: "ML", desc: "Machine Learning" },
  { key: "ds", icon: "📊", name: "DS", desc: "Data Science" },
  { key: "reading", icon: "📚", name: "Reading", desc: "Books & Essays" },
  { key: "blog", icon: "📝", name: "Blog", desc: "General Posts" },
  { key: "research", icon: "🔬", name: "Research", desc: "Math Modeling" },
  { key: "econ", icon: "📈", name: "Econ", desc: "Economics" },
];

// Gather all posts for recent activity & domain feeds
const allPosts = (await Promise.all(
  domains.map(d => getCollection(d.key as any))
)).flat().sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const recentPosts = allPosts.slice(0, 6);

const domainFeeds = await Promise.all(
  domains.map(async (d) => {
    const posts = await getCollection(d.key as any);
    const latest = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
    return { ...d, latest };
  })
);
---

<TempLayout title="DragonLab">
  <div style="min-height:100vh;display:flex;flex-direction:column;">
    <Header />
    <div class="page-wrapper" style="flex:1;">
      <main class="content-area">
        <!-- Status Banner -->
        <div class="card dashboard-status">
          <span style="font-size:1.3rem;margin-right:8px;">{status.emoji || "📢"}</span>
          <span style="color:var(--color-text);font-weight:600;">{status.text || "Welcome to DragonLab"}</span>
        </div>

        <!-- Recent Activity -->
        <div class="section-header">
          <h2>🔥 Recent Activity</h2>
        </div>
        <div class="dashboard-cards">
          {recentPosts.map(p => (
            <a class="dashboard-card" href={`/DragonLab/temp/${p.collection}/${p.slug}/`}>
              <div class="dc-domain">{p.collection}</div>
              <div class="dc-title">{p.data.title}</div>
              <div class="dc-date">{p.data.date.toISOString().slice(0,10)}</div>
            </a>
          ))}
        </div>

        <!-- Domain Sections -->
        {domainFeeds.filter(d => d.latest.length > 0).map(d => (
          <>
            <div class="section-header">
              <h2>{d.icon} {d.name} <small class="muted">{d.desc}</small></h2>
              <a href={`/DragonLab/${d.key}/`} class="section-more">More →</a>
            </div>
            <div class="dashboard-cards">
              {d.latest.map(p => (
                <a class="dashboard-card" href={`/DragonLab/temp/${p.collection}/${p.slug}/`}>
                  <div class="dc-title">{p.data.title}</div>
                  <div class="dc-date">{p.data.date.toISOString().slice(0,10)}</div>
                  {p.data.tags?.length > 0 && (
                    <div class="dc-tags">
                      {p.data.tags.slice(0,2).map((t: string) => <span class="dc-tag">{t}</span>)}
                    </div>
                  )}
                </a>
              ))}
            </div>
          </>
        ))}

        {domainFeeds.every(d => d.latest.length === 0) && (
          <div class="card" style="text-align:center;padding:48px;">
            <p class="muted">No posts yet. Open Obsidian and start writing!</p>
            <p style="margin-top:8px;">
              <a href="/DragonLab/temp/" style="color:var(--color-accent);">&rarr; Temp Debug Area</a>
            </p>
          </div>
        )}
      </main>
      <Sidebar posts={recentPosts.slice(0,5).map(p => ({ url: `/DragonLab/temp/${p.collection}/${p.slug}/`, title: p.data.title }))} />
    </div>
    <DomainBar />
    <Footer />
  </div>
</TempLayout>
