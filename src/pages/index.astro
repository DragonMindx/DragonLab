---
import TempLayout from "../layouts/TempLayout.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
---
<TempLayout title="DragonLab">
  <div style="min-height:100vh;display:flex;flex-direction:column;">
    <Header />
    <div class="page-wrapper" style="flex:1;">
      <main class="content-area">
        <div class="card" style="text-align:center;">
          <p style="font-style:italic;font-size:1.8rem;color:var(--color-accent);font-weight:700;margin-bottom:4px;">Mens et Manus</p>
          <p class="muted">DragonLab &middot; Personal Laboratory</p>
        </div>
        <div class="card">
          <h2 style="margin-bottom:12px;">Domains</h2>
          <div class="domain-grid">
            <a class="domain-card" href="/DragonLab/cs/">
              <div class="icon">💻</div><div class="name">CS</div><div class="count">Computer Science</div>
            </a>
            <a class="domain-card" href="/DragonLab/ml/">
              <div class="icon">🧠</div><div class="name">ML</div><div class="count">Machine Learning</div>
            </a>
            <a class="domain-card" href="/DragonLab/ds/">
              <div class="icon">📊</div><div class="name">DS</div><div class="count">Data Science</div>
            </a>
            <a class="domain-card" href="/DragonLab/reading/">
              <div class="icon">📚</div><div class="name">Reading</div><div class="count">Books &amp; Essays</div>
            </a>
            <a class="domain-card" href="/DragonLab/blog/">
              <div class="icon">📝</div><div class="name">Blog</div><div class="count">General Posts</div>
            </a>
            <a class="domain-card" href="/DragonLab/research/">
              <div class="icon">🔬</div><div class="name">Research</div><div class="count">Math Modeling</div>
            </a>
            <a class="domain-card" href="/DragonLab/econ/">
              <div class="icon">📈</div><div class="name">Econ</div><div class="count">Economics</div>
            </a>
          </div>
          <p style="text-align:center;margin-top:16px;">
            <a href="/DragonLab/temp/" style="color:var(--color-accent);font-weight:600;">→ V1 Content (Temp Debug)</a>
          </p>
        </div>
      </main>
      <Sidebar posts={[]} />
    </div>
    <Footer />
  </div>
</TempLayout>
