---
import TempLayout from "../layouts/TempLayout.astro";
---
<TempLayout title="404 | DragonLab">
  <nav class="site-nav">
    <div class="nav-inner">
      <a class="nav-title" href="/DragonLab/">DragonLab</a>
    </div>
  </nav>
  <div style="min-height:100vh;display:flex;flex-direction:column;">
    <div style="flex:1;display:flex;align-items:center;justify-content:center;padding:24px;">
      <div class="card" style="text-align:center;max-width:400px;width:100%;">
        <div style="font-size:4rem;margin-bottom:12px;">🏗️</div>
        <p class="motto" style="font-size:1.1rem;">Under Construction</p>
        <p style="color:var(--color-text-light);margin-top:8px;font-size:0.9rem;">仍在建设中</p>
      </div>
    </div>
  </div>
</TempLayout>
