---
import { DOMAINS } from "../data/domains";
---

<section class="domain-bar-section">
  <div class="section-header">
    <h2>Domains</h2>
  </div>
  <div class="domain-bar-grid">
    {DOMAINS.map(d => {
      const words = d.desc.split(" ");
      const mid = Math.ceil(words.length / 2);
      const line1 = words.slice(0, mid).join(" ");
      const line2 = words.slice(mid).join(" ");
      return (
        <a class="dashboard-card domain-bar-card" href={`/DragonLab/${d.key}/`}>
          <div class="domain-card-icon">{d.icon}</div>
          <div class="domain-card-code">{d.name}</div>
          <div class="domain-card-name">
            <span>{line1}</span>
            {line2 && <span>{line2}</span>}
          </div>
        </a>
      );
    })}
  </div>
</section>
